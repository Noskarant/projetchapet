NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Accès serveur Supabase : utilisé uniquement côté serveur pour les connexions PA chiffrées.
SUPABASE_SERVICE_ROLE_KEY=

# Structuration des dictées en JSON
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Transcription audio serveur
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Envoi réel des PDF par e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Facturation électronique France — Plateforme Agréée SUPER PDP
# Application OAuth éditeur à créer dans SUPER PDP.
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
SUPERPDP_API_BASE_URL=https://api.superpdp.tech
SUPERPDP_REDIRECT_URI=https://manufeo.fr/api/einvoice/superpdp/callback
# Secret serveur aléatoire de 32+ caractères pour chiffrer les jetons OAuth et signer state.
EINVOICE_SECRET=
