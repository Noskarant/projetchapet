{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/transcribe/route.ts": {
      "maxDuration": 300
    },
    "app/api/ai/parse-strict/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/monthly-accounting/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [{ "path": "/api/cron/monthly-accounting", "schedule": "0 7 * * *" }]
}
